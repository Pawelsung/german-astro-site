---
import Layout from '../layouts/Layout.astro';
import UserAccount from './UserAccount.jsx';

interface Frontmatter {
  title: string;
  description: string;
  tags?: string[];
  theme?: string;
}

interface Props {
  frontmatter: Frontmatter;
  contentClass?: string;
}

const { frontmatter, contentClass = 'w-full flex-grow relative z-10 px-4 pb-10' } = Astro.props;
const hasTips = await Astro.slots.has('tips');
const themes = {
  sky: {
    page: 'bg-sky-50/45',
    link: 'text-sky-700 hover:bg-sky-50',
    chip: 'bg-sky-50 text-sky-700 border-sky-100',
    tips: 'bg-sky-50 border-sky-100 text-sky-800',
    bullet: 'text-sky-500'
  },
  emerald: {
    page: 'bg-emerald-50/45',
    link: 'text-emerald-700 hover:bg-emerald-50',
    chip: 'bg-emerald-50 text-emerald-700 border-emerald-100',
    tips: 'bg-emerald-50 border-emerald-100 text-emerald-800',
    bullet: 'text-emerald-500'
  },
  amber: {
    page: 'bg-amber-50/45',
    link: 'text-amber-700 hover:bg-amber-50',
    chip: 'bg-amber-50 text-amber-700 border-amber-100',
    tips: 'bg-amber-50 border-amber-100 text-amber-800',
    bullet: 'text-amber-500'
  },
  violet: {
    page: 'bg-violet-50/40',
    link: 'text-violet-700 hover:bg-violet-50',
    chip: 'bg-violet-50 text-violet-700 border-violet-100',
    tips: 'bg-violet-50 border-violet-100 text-violet-800',
    bullet: 'text-violet-500'
  },
  teal: {
    page: 'bg-teal-50/45',
    link: 'text-teal-700 hover:bg-teal-50',
    chip: 'bg-teal-50 text-teal-700 border-teal-100',
    tips: 'bg-teal-50 border-teal-100 text-teal-800',
    bullet: 'text-teal-500'
  }
};
const lessonLinks = [
  ['/lesson1-wort/', '單字'], ['/lesson2-VerbWithPreposition/', '介系詞'],
  ['/lesson3-irregular-verbs/', '動詞'], ['/lesson4-kasus/', '格位'],
  ['/lesson5-connectors/', '語序'], ['/lesson6-adjective-declension/', '字尾']
];
const theme = themes[frontmatter.theme ?? ''] ?? themes.sky;
const shortTitle = frontmatter.title.split('｜').pop();
---

<Layout title={frontmatter.title}>
  <main class={`min-h-screen ${theme.page} text-slate-800 flex flex-col`} data-lesson-title={shortTitle}>
    <div class="w-full px-4 pt-3 md:pt-4 pb-2 md:pb-3">
      <div class="max-w-6xl mx-auto">
        <div class="mb-2 md:mb-3 flex items-center justify-between gap-2">
          <a
            href="/"
            class={`${theme.link} font-black inline-flex items-center gap-2 px-3 py-2 rounded-lg transition-all w-fit text-sm`}
          >
            ← <span class="sm:hidden">首頁</span><span class="hidden sm:inline">返回學習工作台</span>
          </a>
          <div class="flex items-center gap-2">
            <button type="button" class="sound-toggle" data-sound-toggle aria-pressed="true" title="答題音效" aria-label="答題音效">
              <span data-sound-icon aria-hidden="true">🔊</span><span class="hidden sm:inline">音效</span>
            </button>
            <UserAccount client:only="react" compact />
          </div>
        </div>

        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div class="min-w-0">
            <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-800 tracking-tight leading-tight">
              {frontmatter.title}
            </h1>

            <p class="mt-2 hidden sm:block max-w-3xl text-slate-600 leading-relaxed font-medium text-sm">
              {frontmatter.description}
            </p>
          </div>

          {frontmatter.tags?.length && (
            <div class="hidden sm:flex flex-wrap gap-2 md:max-w-sm md:justify-end">
              {frontmatter.tags.slice(0, 4).map((tag) => (
                <span class={`px-2.5 py-1 ${theme.chip} text-[11px] font-black rounded-full border`}>
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    <nav aria-label="切換學習主題" class="lesson-nav mx-auto flex w-full max-w-6xl gap-1 overflow-x-auto px-4 pb-3 md:pb-4">
      {lessonLinks.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '') ? 'page' : undefined} class="lesson-nav-link">{label}</a>)}
    </nav>
    <div class={contentClass}>
      <slot />
    </div>

    {hasTips && (
      <div class="w-full px-4 pb-12 mt-2 mb-8 relative z-0">
        <div class={`max-w-4xl mx-auto ${theme.tips} p-5 rounded-2xl border`}>
          <h3 class="text-base font-black mb-4 flex items-center gap-2">
            學習提示
          </h3>

          <ul class="space-y-4 text-sm font-bold">
            <slot name="tips" />
          </ul>
        </div>
      </div>
    )}
  </main>
  <script>
    import { SOUND_STORAGE_KEY, isSoundEnabled } from '../lib/answerFeedback';
    import { recordLessonVisit } from '../lib/dailyActivity.mjs';

    const lessonTitle = document.querySelector('[data-lesson-title]')?.getAttribute('data-lesson-title');
    if (lessonTitle) recordLessonVisit(location.pathname, lessonTitle);

    const toggle = document.querySelector('[data-sound-toggle]');
    const icon = document.querySelector('[data-sound-icon]');
    const render = (on) => {
      toggle?.setAttribute('aria-pressed', String(on));
      if (icon) icon.textContent = on ? '🔊' : '🔇';
    };
    render(isSoundEnabled());
    toggle?.addEventListener('click', () => {
      const on = !isSoundEnabled();
      try { localStorage.setItem(SOUND_STORAGE_KEY, String(on)); } catch {}
      render(on);
    });
  </script>
</Layout>
