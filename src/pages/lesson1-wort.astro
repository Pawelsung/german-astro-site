---
import LessonShell from '../components/LessonShell.astro';
import LessonSkeleton from '../components/LessonSkeleton.astro';
import VocabularyTrainer from '../components/VocabularyTrainer.jsx';

export const frontmatter = {
  title: "單字學習｜分課練習",
  description: "依教材與課次練習單字、冠詞和聽寫，接著複習還不熟悉的內容。",
  category: "單字練習",
  tags: ["詞彙整理", "聽寫", "學習紀錄"],
  order: 1,
  level: "A1-B1",
  estimatedMinutes: 15,
  theme: "sky"
};
---

<LessonShell frontmatter={frontmatter}>
  <div class="max-w-6xl mx-auto">
    <VocabularyTrainer client:only="react"><LessonSkeleton slot="fallback" /></VocabularyTrainer>
  </div>
</LessonShell>
