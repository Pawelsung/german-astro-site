---
import Layout from '../layouts/Layout.astro';
import LearningDashboard from '../components/LearningDashboard.jsx';
import UserAccount from '../components/UserAccount.jsx';
import { verbPrepositions } from '../data/verb-prepositions';
import { irregularVerbs } from '../data/irregular-verbs';
import kasusData from '../data/lesson4-kasus-quest-data.json';
import connectorData from '../data/connectors-question-bank.json';
import adjectiveData from '../data/lesson6-adjective-declension';
import { konjunktivExercises } from '../data/lesson7-konjunktiv';
import { formExercises } from '../lib/konjunktiv.mjs';

const allFiles = import.meta.glob('./*.{mdx,astro}', { eager: true });

const allLessons = Object.entries(allFiles)
  .filter(([path, mod]: [string, any]) => {
    const fileName = path.split('/').pop();
    const isIndex = fileName === 'index.astro';
    return !isIndex && mod.frontmatter?.title;
  })
  .map(([_, mod]: [string, any]) => mod)
  .sort((a: any, b: any) => (a.frontmatter.order ?? 999) - (b.frontmatter.order ?? 999));

// Item counts per lesson order, used for the progress bars (lesson 1 uses the loaded word list).
const totals: Record<number, number> = {
  2: verbPrepositions.length,
  3: irregularVerbs.length,
  4: kasusData.exercises?.length ?? 0,
  5: connectorData.questions?.length ?? 0,
  6: adjectiveData.exercises?.length ?? 0,
  7: formExercises().length + konjunktivExercises.length
};

const lessons = allLessons.map(({ url, frontmatter }: any) => ({
  href: url,
  order: frontmatter.order,
  title: frontmatter.title,
  description: frontmatter.description,
  level: frontmatter.level,
  minutes: frontmatter.estimatedMinutes,
  theme: frontmatter.theme ?? 'sky',
  category: frontmatter.category,
  total: totals[frontmatter.order] ?? 0
}));
---

<Layout title="德語學習工作台 | German Learning Workspace">
  <header class="home-header">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-4">
      <a href="/" class="flex min-w-0 items-center gap-3">
        <span class="home-logo" aria-hidden="true">DE</span>
        <span class="min-w-0">
          <span class="block truncate text-lg font-black leading-tight text-slate-900">德語學習工作台</span>
          <span class="hidden text-xs font-bold text-slate-500 sm:block">詞彙、動詞與文法的系統化練習</span>
        </span>
      </a>
      <UserAccount client:only="react" compact />
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 pb-24 pt-4 md:pt-6">
    {lessons.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-12 text-center">
        <p class="text-xl font-bold text-gray-400">目前還沒有符合條件的課程檔案</p>
        <p class="mt-2 text-sm text-gray-400">請檢查檔案頂部是否有正確的 title 與 category 設定</p>
      </div>
    ) : (
      <LearningDashboard client:load lessons={lessons} />
    )}
  </main>
</Layout>
